# Public site URL (no trailing slash) — used for canonical URLs, Open Graph, sitemap
# Example: https://adachinda.vercel.app  or  https://your-custom-domain.com
NEXT_PUBLIC_SITE_URL=

# Contact form (Formspree) — server-only, never expose as NEXT_PUBLIC_*
# 1. Create a form at https://formspree.io
# 2. Copy the form id from the endpoint https://formspree.io/f/xxxxxxxx
# 3. Paste below
FORMSPREE_FORM_ID=
